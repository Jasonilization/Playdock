diff --git a/Tests/ExeDockTests/LocalizationTests.swift b/Tests/ExeDockTests/LocalizationTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..403b221a27c3ab247de73bd68f656fd50ffef8a4
--- /dev/null
+++ b/Tests/ExeDockTests/LocalizationTests.swift
@@ -0,0 +1,39 @@
+import Foundation
+import Testing
+@testable import ExeDock
+
+@Suite("Localization")
+struct LocalizationTests {
+    /// `LF` hands translations straight to `String(format:)`, so a translation whose
+    /// placeholders differ from its English key can print garbage or crash.
+    private func placeholders(_ text: String) -> [String] {
+        let regex = try! NSRegularExpression(pattern: "%(lld|ld|d|@|\\.?\\d*f)")
+        let range = NSRange(text.startIndex..., in: text)
+        return regex.matches(in: text, range: range).compactMap { Range($0.range, in: text).map { String(text[$0]) } }
+    }
+
+    @Test func translationsKeepTheirKeysPlaceholders() {
+        for (language, table) in Localization.tables {
+            for (key, value) in table {
+                #expect(placeholders(key) == placeholders(value), "\(language.rawValue): \(key)")
+            }
+        }
+    }
+
+    @Test func engineUpdateMessagesSubstituteTheEngineName() {
+        let keys = [
+            "A newer engine is available: %@",
+            "You already have the latest recommended engine (%@).",
+            "Downloaded %@ - pick it in Advanced Mode's engine list, or it'll be offered next time a bottle needs (re)initializing.",
+        ]
+        for language in AppLanguage.allCases where language != .system {
+            for key in keys {
+                let text = String(format: Localization.string(key, in: language), "Engine-X")
+                #expect(text.contains("Engine-X"), "\(language.rawValue): \(key)")
+                if language != .english {
+                    #expect(Localization.string(key, in: language) != key, "\(language.rawValue) missing: \(key)")
+                }
+            }
+        }
+    }
+}
