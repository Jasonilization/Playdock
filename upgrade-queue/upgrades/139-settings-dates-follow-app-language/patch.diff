--- a/Sources/ExeDock/Support/Localization.swift
+++ b/Sources/ExeDock/Support/Localization.swift
@@ -98,6 +98,22 @@ enum Localization {
         string(key, in: active)
     }
 
+    /// For date/number formatters, which otherwise follow the Mac's locale and would print
+    /// "3 hours ago" in the middle of an otherwise-French screen.
+    static var locale: Locale {
+        locale(for: active, current: .current)
+    }
+
+    /// Keeps the Mac's own locale (and so its region's date style) whenever it already speaks
+    /// `language`; only a language the Mac isn't set to gets a bare language locale.
+    static func locale(for language: AppLanguage, current: Locale) -> Locale {
+        let target = Locale(identifier: language.rawValue).language
+        let mac = current.language
+        let sameScript = target.script == nil || mac.script == nil || target.script == mac.script
+        if target.languageCode == mac.languageCode && sameScript { return current }
+        return Locale(identifier: language.rawValue)
+    }
+
